# Copy to a local .env file. Never commit real API keys.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-3-7-sonnet-latest

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

LLM_DEFAULT_PROVIDER=openai
LLM_FALLBACK_ORDER=openai,claude,deepseek

# DesignBuddy project editor API (server-side only; never expose these in Vite variables)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
DESIGNBUDDY_PROJECT_STORE_PATH=./data/projects.json

# Optional separately hosted backend URL for the web client; the client appends /api.
# For cross-origin use, configure credentialed CORS and secure session cookies on the backend.
VITE_API_BASE_URL=
